generator client {
  provider        = "prisma-client-js"
  output          = "./client"
  previewFeatures = ["tracing"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Warehouse {
  id      String @id
  name    String
  country String
}
